@model Ticket
@{
    ViewData["Title"] = "Raise New Ticket";
}

<h1>Raise New Ticket</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="field">
        <label asp-for="Title"></label>
        <input asp-for="Title" type="text" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="field">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="field">
        <label asp-for="RaisedBy"></label>
        <input asp-for="RaisedBy" type="text" />
    </div>

    <div class="field">
        <label asp-for="Priority"></label>
        <select asp-for="Priority">
            <option value="">-- Select Priority --</option>
            @foreach (var p in TicketOptions.Priorities)
            {
                <option value="@p">@p</option>
            }
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <!-- Status is hardcoded to Open on the server; shown here read-only -->
    <!-- Status is hardcoded to Open. The disabled input is just for display —
     disabled fields are never submitted, so a hidden field carries the real value. -->
  <div class="field">
    <label>Status</label>
    <input type="text" value="Open" disabled />
    <input type="hidden" asp-for="Status" value="Open" />
 </div>

    <button type="submit" class="btn">Create Ticket</button>
    <a class="btn" asp-action="Index">Cancel</a>
</form>
