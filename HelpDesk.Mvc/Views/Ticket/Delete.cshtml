@model Ticket
@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>Delete Ticket #@Model.Id</h1>

<p>Are you sure you want to delete this ticket?</p>

<table>
    <tr><th>Title</th><td>@Model.Title</td></tr>
    <tr><th>Priority</th><td>@Model.Priority</td></tr>
    <tr><th>Status</th><td>@Model.Status</td></tr>
</table>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="margin-top:16px;">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn" asp-action="Index">Cancel</a>
</form>
