@model Ticket
@{
    ViewData["Title"] = "Ticket Details";
}

<h1>Ticket #@Model.Id</h1>

<table>
    <tr><th>Title</th><td>@Model.Title</td></tr>
    <tr><th>Description</th><td>@Model.Description</td></tr>
    <tr><th>Priority</th><td>@Model.Priority</td></tr>
    <tr><th>Status</th><td>@Model.Status</td></tr>
    <tr><th>Raised By</th><td>@Model.RaisedBy</td></tr>
    <tr><th>Created Date</th><td>@Model.CreatedDate</td></tr>
</table>

<p style="margin-top:16px;">
    <a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn" asp-action="Index">Back to List</a>
</p>
