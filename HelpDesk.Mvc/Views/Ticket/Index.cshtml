@model List<Ticket>
@{
    ViewData["Title"] = "All Tickets";
}

<h1>All Tickets</h1>
<p><a class="btn" asp-action="Create">+ Raise New Ticket</a></p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Raised By</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var ticket in Model)
    {
        <tr>
            <td>@ticket.Id</td>
            <td>@ticket.Title</td>
            <td>@ticket.Priority</td>
            <td>@ticket.Status</td>
            <td>@ticket.RaisedBy</td>
            <td>@ticket.CreatedDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Details" asp-route-id="@ticket.Id">View</a> |
                <a asp-action="Edit" asp-route-id="@ticket.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@ticket.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
